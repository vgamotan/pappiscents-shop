# Copy this file to .env and fill in real values.
# Never commit your real .env file or share these values publicly.

# Make up any random string — you'll enter this same string in the
# Meta for Developers webhook setup screen.
FB_VERIFY_TOKEN=choose-a-random-secret-string

# From Meta for Developers > your App > Messenger > Page Access Token
FB_PAGE_ACCESS_TOKEN=your-page-access-token-here

# From console.anthropic.com > API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

PORT=3000
